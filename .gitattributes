# Auto-detect text files; normalize to LF in the repo, let clients handle conversion
* text=auto

# Force common Unity text formats to use LF in the repo
*.cs    text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl  text eol=lf
*.asmdef text eol=lf
*.meta  text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat   text eol=lf
*.anim  text eol=lf
*.controller text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf

# Binary files — do not treat as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.fbx   binary
*.mp4   binary
*.wav   binary
*.mp3   binary
*.zip   binary
*.unitypackage binary

# LFS (if you use LFS, keep .gitattributes entries added by `git lfs track`)
# Example: (uncomment if tracking by LFS)
# *.psd filter=lfs diff=lfs merge=lfs -text